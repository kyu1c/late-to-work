# late-to-work 환경변수 예시
# 실제 값은 절대 커밋하지 않는다. 각 환경변수는 아래 이름의 값을 설정한다.
#
# 로컬 개발: .env.local 파일에 실제 값을 넣는다 (gitignore 대상).
# Vercel 배포: Vercel 대시보드 Environment Variables에 각 키 등록.

# 카카오 REST API 키 (주소검색 등)
KAKAO_REST_API_KEY=

# Tmap 앱키 (차량 경로, 택시 ETA)
TMAP_APP_KEY=

# ODsay API 키 (대중교통 통합 길찾기)
ODSAY_API_KEY=

# TAGO 버스 API 키
TAGO_BUS_KEY=

# TAGO 지하철 API 키
TAGO_SUBWAY_KEY=

# 기상청 초단기예보 API 키
KMA_WEATHER_KEY=

# Upstage API 키 (사용된 경우)
UPSTAGE_API_KEY=
